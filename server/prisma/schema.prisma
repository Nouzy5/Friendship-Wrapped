// Prisma schema for Friendship Wrapped.
// Connection settings live in ../prisma.config.ts; models are added phase by phase.
// Tables and columns use snake_case in MySQL; Prisma fields stay camelCase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  /// UUIDv7: time-ordered (InnoDB-friendly) and not guessable/enumerable in URLs.
  id                  String               @id @default(uuid(7)) @db.Char(36)
  /// Always stored lowercase; uniqueness is enforced by the database.
  username            String               @unique @db.VarChar(20)
  displayName         String               @map("display_name") @db.VarChar(40)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  /// Object-storage key of the profile picture; null shows initials instead.
  avatarKey           String?              @map("avatar_key") @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  sessions            Session[]
  memberships         GroupMember[]
  invites             InviteToken[]
  photos              Photo[]
  reactions           Reaction[]
  comments            Comment[]
  favorites           Favorite[]
  albums              Album[]
  moments             Moment[]
  settings            UserSettings?
  blocksMade          Block[]              @relation("BlocksMade")
  blocksReceived      Block[]              @relation("BlocksReceived")
  reportsMade         Report[]             @relation("ReportsMade")
  reportsReceived     Report[]             @relation("ReportsReceived")
  pushSubscriptions   PushSubscription[]
  apnsDevices         ApnsDevice[]
  queuedNotifications QueuedNotification[]

  @@map("users")
}

model Session {
  /// SHA-256 (hex) of the session token. The raw token only ever lives in the user's cookie.
  id           String   @id @db.Char(64)
  userId       String   @map("user_id") @db.Char(36)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  /// The browser or app that signed in (truncated), for the list of signed-in devices.
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  /// Refreshed at most every few minutes while the session is in use.
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The iPhone this session is on, if the app registered it for push.
  apnsDevices  ApnsDevice[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum GroupRole {
  OWNER
  MEMBER
}

/// Note: GROUPS is a reserved word in MySQL 8; always backtick `groups` in raw SQL.
model Group {
  id        String        @id @default(uuid(7)) @db.Char(36)
  name      String        @db.VarChar(50)
  /// A single emoji grapheme (may be several code points, e.g. flags or ZWJ sequences).
  emoji     String        @db.VarChar(16)
  /// Object-storage key of the group photo (under the group's storage prefix); null shows the emoji.
  avatarKey String?       @map("avatar_key") @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  members   GroupMember[]
  invites   InviteToken[]
  photos    Photo[]
  albums    Album[]
  moments   Moment[]
  wrapped   Wrapped[]

  @@map("groups")
}

/// The member colours, in palette order: newcomers get the first one free in their group.
enum MemberColor {
  LIME
  COBALT
  TOMATO
  SUN
  BUBBLEGUM
  MINT
  LILAC
  PLUM
  SKY
  FOREST
  TANGERINE
  CHERRY
}

/// Membership is the single source of truth for roles: each group has exactly one OWNER.
model GroupMember {
  groupId  String       @map("group_id") @db.Char(36)
  userId   String       @map("user_id") @db.Char(36)
  role     GroupRole    @default(MEMBER)
  /// Unique within the group. Null once all twelve are taken (clients show grey).
  color    MemberColor?
  /// A muted group sends this member no push notifications.
  muted    Boolean      @default(false)
  joinedAt DateTime     @default(now()) @map("joined_at")
  group    Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  /// MySQL allows any number of NULLs in a unique index, so colourless members don't collide.
  @@unique([groupId, color])
  @@index([userId])
  @@map("group_members")
}

model InviteToken {
  /// SHA-256 (hex) of the invite token. The raw token only exists in the shared link.
  id          String   @id @db.Char(64)
  groupId     String   @map("group_id") @db.Char(36)
  createdById String   @map("created_by_id") @db.Char(36)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([createdById])
  @@map("invite_tokens")
}

/// What a post is. A video is still a Photo row: its three image renditions are the video's poster
/// frame, so reactions, comments, albums, moments and Wrapped treat it like any other post.
enum MediaKind {
  PHOTO
  VIDEO
}

/// A photo shared with one group. The image bytes live in object storage; only their keys are stored here.
model Photo {
  id           String       @id @default(uuid(7)) @db.Char(36)
  groupId      String       @map("group_id") @db.Char(36)
  uploaderId   String       @map("uploader_id") @db.Char(36)
  caption      String?      @db.VarChar(500)
  /// Full-size rendition (the original upload is not kept).
  storageKey   String       @map("storage_key") @db.VarChar(255)
  mediumKey    String       @map("medium_key") @db.VarChar(255)
  thumbnailKey String       @map("thumbnail_key") @db.VarChar(255)
  /// Pixel size of the full-size rendition.
  width        Int
  height       Int
  /// Byte size of the full-size rendition.
  sizeBytes    Int          @map("size_bytes")
  kind         MediaKind    @default(PHOTO)
  /// Object-storage key of the video (an H.264 MP4 the server made), for a video; null for a photo.
  videoKey        String?   @map("video_key") @db.VarChar(255)
  videoDurationMs Int?      @map("video_duration_ms")
  videoSizeBytes  Int?      @map("video_size_bytes")
  /// A Live Photo's motion: it plays by itself, muted and looping, rather than on tap.
  videoIsLive     Boolean   @default(false) @map("video_is_live")
  /// Upload time.
  createdAt    DateTime     @default(now()) @map("created_at")
  /// The moment this photo was posted into, if the poster chose one while it was open. A photo is
  /// in at most one; deleting the moment leaves the photo in the group.
  momentId     String?      @map("moment_id") @db.Char(36)
  moment       Moment?      @relation(fields: [momentId], references: [id], onDelete: SetNull)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Restrict: deleting an account deletes the person's photos first (users.service deleteAccount), so none is left orphaned.
  uploader     User         @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  reactions    Reaction[]
  comments     Comment[]
  favorites    Favorite[]
  albums       PhotoAlbum[]
  reports      Report[]

  /// Newest-first group listing with a (createdAt, id) keyset cursor.
  @@index([groupId, createdAt, id])
  @@index([uploaderId, createdAt])
  /// A moment's photos, oldest first with the same cursor.
  @@index([momentId, createdAt, id])
  @@map("photos")
}

/// The five reactions: ❤️ HEART, 😂 LAUGH, 💀 SKULL, 🔥 FIRE, 😭 CRY.
enum ReactionType {
  HEART
  LAUGH
  SKULL
  FIRE
  CRY
}

/// One reaction per person per photo: reacting again changes it. Kept for Wrapped statistics.
model Reaction {
  photoId   String       @map("photo_id") @db.Char(36)
  userId    String       @map("user_id") @db.Char(36)
  type      ReactionType
  /// When the person first reacted to the photo.
  createdAt DateTime     @default(now()) @map("created_at")
  /// When they last changed it.
  updatedAt DateTime     @updatedAt @map("updated_at")
  photo     Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([photoId, userId])
  @@index([userId, createdAt])
  @@map("reactions")
}

model Comment {
  id        String   @id @default(uuid(7)) @db.Char(36)
  photoId   String   @map("photo_id") @db.Char(36)
  authorId  String   @map("author_id") @db.Char(36)
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  /// Restrict, like photos: deleting an account deletes the person's comments first.
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  /// Oldest-first listing per photo with a (createdAt, id) keyset cursor.
  @@index([photoId, createdAt, id])
  @@index([authorId, createdAt])
  @@map("comments")
}

/// A private bookmark: only the person who favorited a photo sees it.
model Favorite {
  userId    String   @map("user_id") @db.Char(36)
  photoId   String   @map("photo_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
  @@index([photoId])
  @@map("favorites")
}

/// A shared album in a group: any member can add or remove photos.
model Album {
  id          String       @id @default(uuid(7)) @db.Char(36)
  groupId     String       @map("group_id") @db.Char(36)
  /// Null once the creator's account is gone: the album belongs to the group.
  createdById String?      @map("created_by_id") @db.Char(36)
  name        String       @db.VarChar(60)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  photos      PhotoAlbum[]

  @@index([groupId, createdAt])
  @@index([createdById])
  @@map("albums")
}

/// Which photos are in which album. A photo can be in several albums of its own group.
model PhotoAlbum {
  albumId String   @map("album_id") @db.Char(36)
  photoId String   @map("photo_id") @db.Char(36)
  addedAt DateTime @default(now()) @map("added_at")
  album   Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photo   Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([albumId, photoId])
  /// The most recently added photo is the album's cover.
  @@index([albumId, addedAt])
  @@index([photoId])
  @@map("photo_albums")
}

/// Something the group is doing right now, or did: "Friday at the lake". Anyone in the group can
/// start one; for a few hours it is open, and photos posted into it are collected on its page.
/// A group has at most one open at a time. Not an album: an album is a collection of photos that
/// already exist, picked by hand afterwards; a moment is open while it happens and closes by itself.
model Moment {
  id          String   @id @default(uuid(7)) @db.Char(36)
  groupId     String   @map("group_id") @db.Char(36)
  /// Null once the creator's account is gone: a moment belongs to the group, like an album.
  createdById String?  @map("created_by_id") @db.Char(36)
  title       String   @db.VarChar(60)
  /// One emoji, or none.
  emoji       String?  @db.VarChar(16)
  /// When it started: also its place in the group's list, with a (createdAt, id) keyset cursor.
  createdAt   DateTime @default(now()) @map("created_at")
  /// When it closes to new photos. Ending it early moves this to that moment.
  endsAt      DateTime @map("ends_at")
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  photos      Photo[]

  @@index([groupId, createdAt, id])
  @@index([createdById])
  @@map("moments")
}

/// A finished year's Wrapped, saved the first time it's opened after the year ends, so it
/// always tells the same story. A year still in progress is counted live and not saved.
model Wrapped {
  groupId     String   @map("group_id") @db.Char(36)
  year        Int      @db.SmallInt
  /// The IANA zone the year was counted in (canonical name). Friends elsewhere get their own.
  timeZone    String   @map("time_zone") @db.VarChar(64)
  /// The numbers, with people and photos as ids (analytics YearNumbers plus a format version).
  stats       Json
  generatedAt DateTime @default(now()) @map("generated_at")
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, year, timeZone])
  @@map("wrapped")
}

/// Server-side preferences, one row per person, created on their first change: a missing
/// row means every default (see settings.dto). Appearance and camera settings stay on the device.
model UserSettings {
  userId               String   @id @map("user_id") @db.Char(36)
  /// Whether other members may download this person's photos.
  allowPhotoSaving     Boolean  @default(true) @map("allow_photo_saving")
  showInWrapped        Boolean  @default(true) @map("show_in_wrapped")
  /// The person's IANA zone (canonical name), sent by the client. Quiet hours and scheduled notifications need it.
  timeZone             String?  @map("time_zone") @db.VarChar(64)
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  notifyPhotos         Boolean  @default(true) @map("notify_photos")
  notifyReactions      Boolean  @default(true) @map("notify_reactions")
  notifyComments       Boolean  @default(true) @map("notify_comments")
  notifyMembers        Boolean  @default(false) @map("notify_members")
  notifyOnThisDay      Boolean  @default(true) @map("notify_on_this_day")
  notifyWrapped        Boolean  @default(true) @map("notify_wrapped")
  /// A gentle reminder to post, at most one per fortnight (see notification-scheduler).
  notifyNudges         Boolean  @default(true) @map("notify_nudges")
  /// When someone in a group starts a moment.
  notifyMoments        Boolean  @default(true) @map("notify_moments")
  quietHoursEnabled    Boolean  @default(true) @map("quiet_hours_enabled")
  /// "HH:MM" (24-hour) in timeZone. A window may run past midnight.
  quietHoursStart      String   @default("23:00") @map("quiet_hours_start") @db.Char(5)
  quietHoursEnd        String   @default("08:00") @map("quiet_hours_end") @db.Char(5)
  /// Scheduler bookkeeping: the local day ("YYYY-MM-DD") On This Day last ran for.
  onThisDayCheckedOn   String?  @map("on_this_day_checked_on") @db.Char(10)
  /// Scheduler bookkeeping: the last year whose Wrapped was announced.
  wrappedAnnouncedYear Int?     @map("wrapped_announced_year") @db.SmallInt
  /// Scheduler bookkeeping: when the person was last nudged. At most one nudge per fortnight, whatever the group.
  nudgedAt             DateTime? @map("nudged_at")
  /// Scheduler bookkeeping: the local day ("YYYY-MM-DD") the person was last considered for a nudge,
  /// so the check runs once a day rather than every minute.
  nudgeCheckedOn       String?  @map("nudge_checked_on") @db.Char(10)
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// One person blocking another. It works both ways for content: neither sees the other's
/// photos, comments or reactions, and no notifications pass between them.
model Block {
  blockerId String   @map("blocker_id") @db.Char(36)
  blockedId String   @map("blocked_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// A report about a photo or a person. Only stored, for whoever runs the server to review.
model Report {
  id             String   @id @default(uuid(7)) @db.Char(36)
  reporterId     String   @map("reporter_id") @db.Char(36)
  /// Null when the report wasn't about a photo, or the photo has been deleted since.
  photoId        String?  @map("photo_id") @db.Char(36)
  /// Null when the report wasn't about a person, or their account has been deleted since.
  reportedUserId String?  @map("reported_user_id") @db.Char(36)
  message        String   @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at")
  reporter       User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  photo          Photo?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  reportedUser   User?    @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([photoId])
  @@index([reportedUserId])
  @@map("reports")
}

/// One browser's Web Push subscription. Subscribing again with the same endpoint updates it.
model PushSubscription {
  id        String   @id @default(uuid(7)) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  /// The push service URL. 700 characters keeps the unique index within InnoDB's key size.
  endpoint  String   @unique @db.VarChar(700)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Which Apple push server a device token belongs to: Xcode and debug builds use the sandbox,
/// TestFlight and App Store builds production. A token only works on its own.
enum ApnsEnvironment {
  SANDBOX
  PRODUCTION
}

/// One iPhone's Apple Push Notification token. It belongs to the session that registered it, so
/// signing out (here, from another device, or by a session running out) stops the notifications
/// at once, and the next person to sign in on that phone registers it afresh.
model ApnsDevice {
  id          String          @id @default(uuid(7)) @db.Char(36)
  userId      String          @map("user_id") @db.Char(36)
  sessionId   String          @map("session_id") @db.Char(64)
  /// The hex device token iOS hands the app (up to 100 bytes). One phone is one row, whoever is signed in.
  token       String          @unique @db.VarChar(200)
  environment ApnsEnvironment
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("apns_devices")
}

/// A push notification held back by the recipient's quiet hours, sent by the scheduler once
/// they end. A newer one with the same tag replaces it, as it would on the device.
model QueuedNotification {
  id        String   @id @default(uuid(7)) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tag       String   @db.VarChar(100)
  title     String   @db.VarChar(120)
  body      String   @db.VarChar(300)
  url       String   @db.VarChar(255)
  deliverAt DateTime @map("deliver_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@index([deliverAt])
  @@map("notification_queue")
}
