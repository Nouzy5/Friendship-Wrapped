# Copy to `.env` (and `.env.test` with a separate database for tests).
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/friendship_wrapped"

# Object storage (S3 API). Locally this is MinIO, which `npm run dev` / `npm test` start
# with these credentials as its root login. In production, point these at a real bucket
# (AWS S3, Cloudflare R2, …): omit S3_ENDPOINT for AWS, and set S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=fw-local
S3_SECRET_ACCESS_KEY=CHANGE_ME_at_least_8_chars
# Use a separate bucket in .env.test, e.g. friendship-wrapped-test
S3_BUCKET=friendship-wrapped

# Web Push notifications (optional: leave these out and push is simply off). Generate a key
# pair with `npx web-push generate-vapid-keys`. The subject is a contact for push services,
# a mailto: or https: URL. Tests don't need them (they use a fake sender).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Apple push notifications for the iPhone app (optional: leave these out and the app gets none).
# Create a key in Apple Developer → Keys with "Apple Push Notifications service (APNs)" ticked.
# Set either the .p8 file's contents (line breaks as \n if your host wants one line) or its path,
# plus the key's ID and your Team ID. Tests don't need them (they use a fake sender).
APNS_KEY=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# Defaults to this app's bundle identifier.
APNS_TOPIC=

# Video posts (optional): the server converts each video with ffmpeg, so ffmpeg and ffprobe must be
# installed (on the PATH, or give their paths here). Without them photos work as always and videos are refused.
FFMPEG_PATH=
FFPROBE_PATH=

# Email: the link that confirms an address, and the "new sign-in" notice. Any provider's SMTP settings
# work (Resend, Postmark, Amazon SES, Gmail, …). Leave SMTP_HOST out and nothing is sent: in development
# each email is printed in the server log instead (open its link from there); in production an admin
# marks addresses confirmed by hand (admin panel, or `npm run admin:verify-email -w server -- <email> [username]`).
# WITHOUT A MAIL SERVER NOBODY CAN CONFIRM AN ADDRESS AND NOBODY GETS IN: set this up before deploying.
# Tests don't need these (they use a fake mailbox).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); otherwise the connection upgrades with STARTTLS when offered.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# The sender, e.g. Friendship Wrapped <no-reply@your-domain.com>. Required with SMTP_HOST.
MAIL_FROM=
# The web app's public address, which links in emails point to. Required in production with SMTP_HOST.
APP_URL=http://localhost:5173

# The admin panel (/admin) is for whoever runs the server: a comma-separated list of email addresses.
# Only an account with one of these addresses, confirmed, gets in. Use your own.
ADMIN_EMAILS=
# Accounts one address may create per hour (default 30). Raise it for a big group signing up from one address (one Wi-Fi network).
SIGNUP_LIMIT_PER_HOUR=

# How many reverse proxies (nginx, Caddy, Render, Fly, a cloud load balancer, …) sit between the internet and this server.
# Leave it out (or false) when the API is reached directly, as in development. Behind a proxy, set it to exactly how many
# there are (usually 1), or every visitor shares the proxy's address and the per-address limits (sign-up, login, password reset, …) become
# global. Too high is worse: a visitor can fake their address with an X-Forwarded-For header and dodge the limits.
TRUST_PROXY=
