# Copy to `.env` (and `.env.test` with a separate database for tests).
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/friendship_wrapped"

# Object storage (S3 API). Locally this is MinIO, which `npm run dev` / `npm test` start
# with these credentials as its root login. In production, point these at a real bucket
# (AWS S3, Cloudflare R2, …): omit S3_ENDPOINT for AWS, and set S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=fw-local
S3_SECRET_ACCESS_KEY=CHANGE_ME_at_least_8_chars
# Use a separate bucket in .env.test, e.g. friendship-wrapped-test
S3_BUCKET=friendship-wrapped
