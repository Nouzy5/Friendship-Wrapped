# Copy to `.env` (and `.env.test` with a separate database for tests).
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/friendship_wrapped"

# Object storage (S3 API). Locally this is MinIO, which `npm run dev` / `npm test` start
# with these credentials as its root login. In production, point these at a real bucket
# (AWS S3, Cloudflare R2, …): omit S3_ENDPOINT for AWS, and set S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=fw-local
S3_SECRET_ACCESS_KEY=CHANGE_ME_at_least_8_chars
# Use a separate bucket in .env.test, e.g. friendship-wrapped-test
S3_BUCKET=friendship-wrapped

# Web Push notifications (optional: leave these out and push is simply off). Generate a key
# pair with `npx web-push generate-vapid-keys`. The subject is a contact for push services,
# a mailto: or https: URL. Tests don't need them (they use a fake sender).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Apple push notifications for the iPhone app (optional: leave these out and the app gets none).
# Create a key in Apple Developer → Keys with "Apple Push Notifications service (APNs)" ticked.
# Set either the .p8 file's contents (line breaks as \n if your host wants one line) or its path,
# plus the key's ID and your Team ID. Tests don't need them (they use a fake sender).
APNS_KEY=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# Defaults to this app's bundle identifier.
APNS_TOPIC=

# Video posts (optional): the server converts each video with ffmpeg, so ffmpeg and ffprobe must be
# installed (on the PATH, or give their paths here). Without them photos work as always and videos are refused.
FFMPEG_PATH=
FFPROBE_PATH=
